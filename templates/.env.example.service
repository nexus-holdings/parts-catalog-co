# Nexus Holdings — Service Company Environment Configuration
# Template for service-type companies (e.g., Self-Improvement Co, internal tools).
#
# Copy this file: cp .env.example.service .env
# Then fill in the values below.
#
# SECURITY: Never commit .env to version control.
# Use 1Password CLI for secret injection: ./scripts/inject-secrets.sh

# ── Company ──────────────────────────────────────────────────
COMPANY_SLUG=self-improvement
COMPANY_NAME="Self-Improvement Co"
COMPANY_TYPE=service
NODE_ENV=production

# ── Application ──────────────────────────────────────────────
APP_PORT=3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=         # REQUIRED — use: op read "op://Nexus/postgres/password"
POSTGRES_DB=nexus_db
DB_PORT=5432

# ── Nginx ────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Bedrock API (AWS) ───────────────────────────────────────
BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
# AWS_ACCESS_KEY_ID=       # Injected by 1Password CLI
# AWS_SECRET_ACCESS_KEY=   # Injected by 1Password CLI

# ── Service-Specific ────────────────────────────────────────
# Internal API authentication
# INTERNAL_API_KEY=        # Injected by 1Password CLI
NEXUS_CORE_URL=http://localhost:8000

# Regression detection settings
REGRESSION_CHECK_INTERVAL=300
REGRESSION_ERROR_THRESHOLD=5
REGRESSION_LOOKBACK_WINDOW=3600

# Inter-company communication
# WEBHOOK_SIGNING_SECRET=  # Injected by 1Password CLI

# ── Self-Improvement Co Integration ─────────────────────────
# SELF_IMPROVEMENT_WEBHOOK_URL=
# SELF_IMPROVEMENT_TOKEN=  # Injected by 1Password CLI

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
