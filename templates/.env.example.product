# Nexus Holdings — Product Company Environment Configuration
# Template for product-type companies (e.g., Invoicely, SaaS tools).
#
# Copy this file: cp .env.example.product .env
# Then fill in the values below.
#
# SECURITY: Never commit .env to version control.
# Use 1Password CLI for secret injection: ./scripts/inject-secrets.sh

# ── Company ──────────────────────────────────────────────────
COMPANY_SLUG=invoicely
COMPANY_NAME="Invoicely"
COMPANY_TYPE=product
NODE_ENV=production

# ── Application ──────────────────────────────────────────────
APP_PORT=3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=         # REQUIRED — use: op read "op://Nexus/postgres/password"
POSTGRES_DB=nexus_db
DB_PORT=5432

# ── Nginx ────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Bedrock API (AWS) ───────────────────────────────────────
BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
# AWS_ACCESS_KEY_ID=       # Injected by 1Password CLI
# AWS_SECRET_ACCESS_KEY=   # Injected by 1Password CLI

# ── Product-Specific ────────────────────────────────────────
# Stripe integration for billing
# STRIPE_SECRET_KEY=       # Injected by 1Password CLI
# STRIPE_WEBHOOK_SECRET=   # Injected by 1Password CLI
STRIPE_PUBLISHABLE_KEY=

# Customer-facing settings
SESSION_SECRET=            # REQUIRED — use: op read "op://Nexus/${COMPANY_SLUG}/session-secret"
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Self-Improvement Co Integration ─────────────────────────
# SELF_IMPROVEMENT_WEBHOOK_URL=
# SELF_IMPROVEMENT_TOKEN=  # Injected by 1Password CLI

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
