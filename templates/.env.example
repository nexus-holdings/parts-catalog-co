# Nexus Holdings — Environment Configuration
# Copy this file: cp .env.example .env
# Then fill in the values below.
#
# SECURITY: Never commit .env to version control.
# Use 1Password CLI for secret injection: ./scripts/inject-secrets.sh

# ── Company ──────────────────────────────────────────────────
COMPANY_SLUG=my-company
COMPANY_NAME="My Company"
NODE_ENV=production

# ── Application ──────────────────────────────────────────────
APP_PORT=3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=         # REQUIRED — use: op read "op://Nexus/postgres/password"
POSTGRES_DB=nexus_db
DB_PORT=5432

# ── Nginx ────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Bedrock API (AWS) ───────────────────────────────────────
# Credentials injected via 1Password CLI — never set raw keys here.
# See: scripts/inject-secrets.sh
BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514
# AWS_ACCESS_KEY_ID=       # Injected by 1Password CLI
# AWS_SECRET_ACCESS_KEY=   # Injected by 1Password CLI

# ── Self-Improvement Co Integration ─────────────────────────
# Webhook URL for regression detection auto-rollback notifications.
# SELF_IMPROVEMENT_WEBHOOK_URL=
# SELF_IMPROVEMENT_TOKEN=  # Injected by 1Password CLI

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
